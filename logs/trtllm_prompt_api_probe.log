  --prompt_table_path PROMPT_TABLE_PATH
                        Path to .npy file, exported by nemo_prompt_convert.py
  --prompt_tasks PROMPT_TASKS
                        Comma-separated list of tasks for prompt tuning, e.g.,
                        0,3,1,0
  --lora_dir LORA_DIR [LORA_DIR ...]
                        The directory of LoRA weights
  --lora_ckpt_source {hf,nemo}
                        The source of lora checkpoint.
  --lora_task_uids LORA_TASK_UIDS [LORA_TASK_UIDS ...]
                        The list of LoRA task uids; use -1 to disable the LoRA
